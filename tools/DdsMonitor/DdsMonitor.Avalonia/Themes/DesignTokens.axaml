<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Theme-variant colour brushes ───────────────────────────────────── -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Surface -->
      <SolidColorBrush x:Key="Surface.Background"      Color="#FAFAFA"/>
      <SolidColorBrush x:Key="Surface.Panel"           Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Surface.Titlebar"        Color="#F0F0F0"/>
      <SolidColorBrush x:Key="Surface.TitlebarActive"  Color="#E5F1FB"/>
      <!-- Border -->
      <SolidColorBrush x:Key="Border.Subtle"           Color="#D0D0D0"/>
      <SolidColorBrush x:Key="Border.Accent"           Color="#0078D4"/>
      <!-- Foreground -->
      <SolidColorBrush x:Key="Foreground.Primary"      Color="#1F1F1F"/>
      <SolidColorBrush x:Key="Foreground.Secondary"    Color="#6B6B6B"/>
      <!-- Accent states -->
      <SolidColorBrush x:Key="Accent.Receiving"        Color="#107C10"/>
      <SolidColorBrush x:Key="Accent.Paused"           Color="#D29922"/>
      <SolidColorBrush x:Key="Accent.Error"            Color="#C42B1C"/>
      <SolidColorBrush x:Key="Accent.Sparkline"        Color="#0078D4"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- Surface -->
      <SolidColorBrush x:Key="Surface.Background"      Color="#1A1A1A"/>
      <SolidColorBrush x:Key="Surface.Panel"           Color="#242424"/>
      <SolidColorBrush x:Key="Surface.Titlebar"        Color="#2D2D2D"/>
      <SolidColorBrush x:Key="Surface.TitlebarActive"  Color="#003E6B"/>
      <!-- Border -->
      <SolidColorBrush x:Key="Border.Subtle"           Color="#3A3A3A"/>
      <SolidColorBrush x:Key="Border.Accent"           Color="#3399FF"/>
      <!-- Foreground -->
      <SolidColorBrush x:Key="Foreground.Primary"      Color="#F0F0F0"/>
      <SolidColorBrush x:Key="Foreground.Secondary"    Color="#9A9A9A"/>
      <!-- Accent states -->
      <SolidColorBrush x:Key="Accent.Receiving"        Color="#6CCB5F"/>
      <SolidColorBrush x:Key="Accent.Paused"           Color="#E0B341"/>
      <SolidColorBrush x:Key="Accent.Error"            Color="#FF6B6B"/>
      <SolidColorBrush x:Key="Accent.Sparkline"        Color="#3399FF"/>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ── Spacing tokens (base unit: 4 px) ────────────────────────────────── -->
  <x:Double x:Key="Spacing.Sm">4</x:Double>
  <x:Double x:Key="Spacing.Md">8</x:Double>
  <x:Double x:Key="Spacing.Lg">12</x:Double>
  <x:Double x:Key="Spacing.Xl">16</x:Double>
  <x:Double x:Key="Spacing.Xxl">24</x:Double>

  <!-- ── Typography tokens ────────────────────────────────────────────────── -->
  <FontFamily x:Key="FontFamily.Body">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="FontFamily.Mono">Cascadia Mono, Consolas, monospace</FontFamily>
  <x:Double x:Key="FontSize.Body">13</x:Double>
  <x:Double x:Key="FontSize.Caption">12</x:Double>
  <x:Double x:Key="FontSize.Mono">11</x:Double>

</ResourceDictionary>
