<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DdsMonitor.Avalonia.App">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DdsMonitor.Avalonia/Themes/BaseStyles.axaml" />
        <StyleInclude Source="avares://DdsMonitor.Avalonia/Controls/MdiChild.axaml" />
        <StyleInclude Source="avares://DdsMonitor.Avalonia/Controls/MdiHost.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DdsMonitor.Avalonia/Themes/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
