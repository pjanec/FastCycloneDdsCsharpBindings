<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore CycloneDDS.NET from the local artifacts feed (populated by
    `dotnet pack ... -o artifacts/nuget`), and everything else from nuget.org.
    Paths are relative to this file (examples/PackageSmokeTest/).
  -->
  <packageSources>
    <clear />
    <add key="local-artifacts" value="../../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
